def draw_tree(secret, history, reveal):
    """Рисует дерево попыток текстом в консоли.
    history - список кортежей (подсказка, ответ, верно_или_нет).
    reveal - показывать ли загаданное слово."""
    print()
    print("Загаданное слово:", secret if reveal else "???")
    for i, (hint, guess, correct) in enumerate(history):
        last = (i == len(history) - 1)
        # Ветка подсказки
        if last:
            print("└── " + hint)
            child_prefix = "    "
        else:
            print("├── " + hint)
            child_prefix = "│   "
        # Ветка ответа
        mark = "верно!" if correct else "неверно"
        print(child_prefix + "└── " + guess + " - " + mark)
    print()


def play_one_round():
    secret = random.choice(list(WORDS.keys()))
    hints = WORDS[secret]
    history = []

    print("Я загадал слово. У тебя три попытки!")
    for i in range(3):
        print("Подсказка " + str(i + 1) + " из 3: " + hints[i])
        guess = input("Что это? ").strip().lower()
        correct = (guess == secret)
        history.append((hints[i], guess, correct))

        if correct:
            # Раскрываем слово в дереве
            draw_tree(secret, history, True)
            print("Ты угадал! Попыток понадобилось: " + str(i + 1) + ".")
            return
        else:
            print("Неверно.")
            draw_tree(secret, history, False)

    # Попытки закончились
    draw_tree(secret, history, True)
    print("Попытки закончились. Я загадал слово: " + secret + ".")


def main():
    print("Игра 'Отгадай слово'")
